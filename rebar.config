{minimum_otp_vsn, "27"}.

{shell, [
    {config, "config/shell.config"},
    {apps, [golare, crashy]}
]}.

{erl_opts, [
    debug_info
]}.

{src_dirs, [{"src", [{recursive, true}]}]}.

{deps, [
    {uuid, "2.0.7", {pkg, uuid_erl}},
    {certifi, "2.15.0"},
    {gun, {git, "https://github.com/ninenines/gun.git", {tag, "2.6.0"}}},
    {mapz, "2.4.0"}
]}.

{dialyzer, [
    {plt_extra_apps, [
        gun
    ]}
]}.

%% Plugins for rebar3
{project_plugins, [
    {erlfmt, "~>1.3"}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.app.src",
        "src/**/{*.erl, *.hrl}",
        "test/**/{*.erl, *.hrl}",
        "config/*.config.src"
    ]},
    {exclude_files, ["config/vm.args.src"]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{profiles, [
    %% Analyses src only, with cowboy in the PLT: golare_interface calls
    %% cowboy_req optionally, and the test profile would drag the test sources
    %% into the analysis.
    {dialyzer, [
        %% Same pin as the test profile: this only exists to put cowboy in
        %% the PLT, so it must be the cowboy the tests run against.
        {deps, [{cowboy, "2.19.0"}]},
        {dialyzer, [{plt_extra_apps, [gun, cowboy]}]}
    ]},
    {test, [
        {erl_opts, [nowarn_export_all, warnings_as_errors]},
        {deps, [
            %% Pinned so it cannot drift from the cowlib gun pins, which
            %% is the only cowlib built. See #15.
            {cowboy, "2.19.0"},
            meck
        ]},
        {overrides, [
            {override, cowboy, [
                {deps, [
                    {ct_helper,
                        {git, "https://github.com/ninenines/ct_helper.git", {branch, "master"}}},
                    %% No cowlib entry on purpose: it would sit at level 1
                    %% and outrank gun's pin at level 2, so the tests would
                    %% run against a cowlib golare does not ship. Omitting it
                    %% leaves gun's pin as the only source.
                    {ranch, "< 3.0.0"}
                ]}
            ]}
        ]},
        {cover_enabled, true},
        {cover_opts, [verbose]},
        {ct_opts, [{sys_config, "./test/test.config"}]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_extra_paths, ["test"]}
    ]}
]}.
