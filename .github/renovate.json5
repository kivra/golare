{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":dependencyDashboard",
    "replacements:all",
    "workarounds:all",
    "helpers:renovateChangelog",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies",
    ":configMigration",
  ],

  // Global options - scheduling
  timezone: "Europe/Stockholm",
  minimumReleaseAge: "7 days", // This is the default, but exceptions apply, per this file
  schedule: ["* 10-15 * * 1-5"], // This controls PR creation, auto-merge, ...

  // Global options - pull requests
  commitMessageTopic: "{{depName}}",
  semanticCommits: "enabled",
  semanticCommitType: "fix",
  automerge: true,
  labels: ["renovate"],

  // Standard managers
  "renovate-config": {
    enabled: false,
  },

  // Security
  vulnerabilityAlerts: {
    labels: ["security"],
    minimumReleaseAge: null,
  },

  // Exceptional package rules
  packageRules: [
    {
      description: "Update Kivra-internal packages as instantly as possible",
      matchPackageNames: ["/^kivra\\/.*$/"],
      minimumReleaseAge: null,
    },
    {
      description: "Always auto-merge non-major updates",
      matchUpdateTypes: ["minor", "patch"],
      automergeStrategy: "squash",
    },
    {
      description: "Never auto-merge major updates",
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      // This is required because pre v1 we have no guarantees on breakage
      description: "Never auto-merge pre-v1 updates",
      matchCurrentVersion: "/^v?0/",
      automerge: false,
    },
  ],

  // Non-standard managers
  customManagers: [
    {
      description: "Match Hex.pm-based dependencies in rebar.config",
      customType: "regex",
      managerFilePatterns: [
        "/rebar.config/",
      ],
      datasourceTemplate: "hex",
      // Two changes from the shared pattern in our other repos:
      //
      // - the optional {pkg, ...} group, fed to packageNameTemplate. Without
      //   it {uuid, "2.0.7", {pkg, uuid_erl}} is looked up as hex "uuid", a
      //   different (Elixir) package still on 1.x, so uuid_erl never gets a
      //   PR and 2.0.7 shows up unresolvable on the dashboard.
      // - the leading \n, so a dep tuple has to start a line. Mid-line
      //   tuples are things like the {tag, "2.6.0"} inside gun's git dep,
      //   which was otherwise extracted as a hex package called "tag".
      //   rebar.config is erlfmt-formatted and fmt-check enforces it, so
      //   one-dep-per-line is stable here.
      matchStrings: [
        "\\n\\s*,?\\s*\\[?\\s*\\{\\s*'?(?<depName>[a-z][a-z0-9_]*)'?\\s*,\\s*\"(?<currentValue>v?\\d+\\.\\d+(\\.\\d+)?)\"(\\s*,\\s*\\{\\s*pkg\\s*,\\s*'?(?<pkgName>[a-z][a-z0-9_]*)'?\\s*\\})?",
      ],
      packageNameTemplate: "{{#if pkgName}}{{{pkgName}}}{{else}}{{{depName}}}{{/if}}",
      versioningTemplate: "semver",
      extractVersionTemplate: "^(==)?\\s*(?<version>.*$)",
    },
    {
      description: "Match GitHub-based dependencies in rebar.config",
      customType: "regex",
      managerFilePatterns: [
        "/rebar.config/",
      ],
      datasourceTemplate: "github-tags",
      matchStrings: [
        "\\{\\s*git(_subdir)?\\s*,\\s*\"https://github\\.com/(?<org>[^\\/]+)\\/(?<depName>[^.]*)\\.git\"\\s*,\\s*\\{\\s*tag\\s*,\\s*\"(?<prefix>.+/v)?(?<currentValue>[^\"]*)\"",
      ],
      depNameTemplate: "{{{org}}}/{{{depName}}}{{#if prefix}}/{{{replace '/v$' '' prefix}}}{{/if}}",
      extractVersionTemplate: "^{{{prefix}}}(?<version>.*$)",
    },
  ]
}
